rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/profiles
// Document ID: ProfileRecord.id, 1-128 ASCII letters, digits, "_" or "-"
// Fields (all required, except no optional document fields):
//   - id: string, equal to document ID (immutable)
//   - name: string, 1-64 characters
//   - isTemporary: boolean, always false (immutable)
//   - privacyLevel: "standard" | "balanced" | "strict"
//   - webrtcPolicy: "default" | "default_public_interface_only" |
//     "disable_non_proxied_udp" | "disabled"
//   - proxy: map with exactly enabled, mode, host, port; credentials excluded
//   - os: "mac" | "windows"
//   - browserType: "chrome" | "edge" | "brave"
//   - browserVersion: string, 1-64 characters
//   - customUserAgent: optional string, at most 512 characters
//   - language: optional string, at most 128 characters
//   - timezone: optional string, at most 128 characters
//   - remoteDebuggingPort: optional integer, 1024-65535
//   - notes: string, 0-10000 characters
//   - group: string, 0-64 characters
//   - tags: list, at most 20 strings, each at most 64 characters
//   - color: six-digit hex color
//   - createdAt: non-negative epoch milliseconds, immutable
//   - updatedAt: epoch milliseconds, monotonic on update
//
// Local paths, browser runtime state, proxy credentials, browsing history,
// and Chrome profile contents are not stored in these documents.
//
// Collection: users/{userId}/profile_cookies
// Document ID: profileId, 1-128 ASCII letters, digits, "_" or "-"
// Fields (all required):
//   - profileId: string, equal to document ID (immutable)
//   - updatedAt: non-negative epoch milliseconds, monotonic on update
//   - count: non-negative integer (>= 0)
//   - cookiesJson: string, serialized cookies array, at most 1048576 bytes
//   - openUrls: list of strings, at most 50 items, each at most 2048 chars
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(data) {
      return data.keys().hasOnly([
        'id',
        'name',
        'isTemporary',
        'privacyLevel',
        'webrtcPolicy',
        'proxy',
        'os',
        'browserType',
        'browserVersion',
        'customUserAgent',
        'language',
        'timezone',
        'remoteDebuggingPort',
        'notes',
        'group',
        'tags',
        'color',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasRequiredFields(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'isTemporary',
        'privacyLevel',
        'webrtcPolicy',
        'proxy',
        'os',
        'browserType',
        'browserVersion',
        'notes',
        'group',
        'tags',
        'color',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidTag(tag) {
      return tag is string && tag.size() <= 64;
    }

    function isValidTags(tags) {
      return tags is list
        && tags.size() <= 20
        && (tags.size() < 1 || isValidTag(tags[0]))
        && (tags.size() < 2 || isValidTag(tags[1]))
        && (tags.size() < 3 || isValidTag(tags[2]))
        && (tags.size() < 4 || isValidTag(tags[3]))
        && (tags.size() < 5 || isValidTag(tags[4]))
        && (tags.size() < 6 || isValidTag(tags[5]))
        && (tags.size() < 7 || isValidTag(tags[6]))
        && (tags.size() < 8 || isValidTag(tags[7]))
        && (tags.size() < 9 || isValidTag(tags[8]))
        && (tags.size() < 10 || isValidTag(tags[9]))
        && (tags.size() < 11 || isValidTag(tags[10]))
        && (tags.size() < 12 || isValidTag(tags[11]))
        && (tags.size() < 13 || isValidTag(tags[12]))
        && (tags.size() < 14 || isValidTag(tags[13]))
        && (tags.size() < 15 || isValidTag(tags[14]))
        && (tags.size() < 16 || isValidTag(tags[15]))
        && (tags.size() < 17 || isValidTag(tags[16]))
        && (tags.size() < 18 || isValidTag(tags[17]))
        && (tags.size() < 19 || isValidTag(tags[18]))
        && (tags.size() < 20 || isValidTag(tags[19]));
    }

    function isValidProxy(proxy) {
      return proxy is map
        && proxy.keys().hasOnly(['enabled', 'mode', 'host', 'port'])
        && proxy.keys().hasAll(['enabled', 'mode', 'host', 'port'])
        && proxy.enabled is bool
        && proxy.mode in ['direct', 'http', 'https', 'socks5']
        && proxy.host is string
        && proxy.host.size() <= 253
        && proxy.port is int
        && proxy.port >= 1
        && proxy.port <= 65535;
    }

    // Shared schema validator is required for both creates and updates.
    function isValidProfile(profileId) {
      let data = request.resource.data;
      return hasOnlyAllowedFields(data)
        && hasRequiredFields(data)
        && data.id is string
        && data.id == profileId
        && profileId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 64
        && data.isTemporary is bool
        && data.isTemporary == false
        && data.privacyLevel in ['standard', 'balanced', 'strict']
        && data.webrtcPolicy in [
          'default',
          'default_public_interface_only',
          'disable_non_proxied_udp',
          'disabled'
        ]
        && isValidProxy(data.proxy)
        && data.os in ['mac', 'windows']
        && data.browserType in ['chrome', 'edge', 'brave']
        && data.browserVersion is string
        && data.browserVersion.size() >= 1
        && data.browserVersion.size() <= 64
        && (!('customUserAgent' in data)
          || (data.customUserAgent is string
            && data.customUserAgent.size() <= 512
            && !data.customUserAgent.matches('.*[\\r\\n].*')))
        && (!('language' in data)
          || (data.language is string && data.language.size() <= 128))
        && (!('timezone' in data)
          || (data.timezone is string && data.timezone.size() <= 128))
        && (!('remoteDebuggingPort' in data)
          || (data.remoteDebuggingPort is int
            && data.remoteDebuggingPort >= 1024
            && data.remoteDebuggingPort <= 65535))
        && data.notes is string
        && data.notes.size() <= 10000
        && data.group is string
        && data.group.size() <= 64
        && isValidTags(data.tags)
        && data.color is string
        && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.createdAt is int
        && data.createdAt >= 0
        && data.createdAt <= 4102444800000
        && data.updatedAt is int
        && data.updatedAt >= data.createdAt
        && data.updatedAt <= 4102444800000;
    }

    function hasOnlyAllowedProfileCookiesFields(data) {
      return data.keys().hasOnly([
        'profileId',
        'updatedAt',
        'count',
        'cookiesJson',
        'openUrls'
      ]);
    }

    function hasRequiredProfileCookiesFields(data) {
      return data.keys().hasAll([
        'profileId',
        'updatedAt',
        'count',
        'cookiesJson',
        'openUrls'
      ]);
    }

    function isValidOpenUrl(url) {
      return url is string && url.size() <= 2048;
    }

    function isValidOpenUrls(urls) {
      return urls is list
        && urls.size() <= 50
        && (urls.size() < 1 || isValidOpenUrl(urls[0]))
        && (urls.size() < 2 || isValidOpenUrl(urls[1]))
        && (urls.size() < 3 || isValidOpenUrl(urls[2]))
        && (urls.size() < 4 || isValidOpenUrl(urls[3]))
        && (urls.size() < 5 || isValidOpenUrl(urls[4]))
        && (urls.size() < 6 || isValidOpenUrl(urls[5]))
        && (urls.size() < 7 || isValidOpenUrl(urls[6]))
        && (urls.size() < 8 || isValidOpenUrl(urls[7]))
        && (urls.size() < 9 || isValidOpenUrl(urls[8]))
        && (urls.size() < 10 || isValidOpenUrl(urls[9]))
        && (urls.size() < 11 || isValidOpenUrl(urls[10]))
        && (urls.size() < 12 || isValidOpenUrl(urls[11]))
        && (urls.size() < 13 || isValidOpenUrl(urls[12]))
        && (urls.size() < 14 || isValidOpenUrl(urls[13]))
        && (urls.size() < 15 || isValidOpenUrl(urls[14]))
        && (urls.size() < 16 || isValidOpenUrl(urls[15]))
        && (urls.size() < 17 || isValidOpenUrl(urls[16]))
        && (urls.size() < 18 || isValidOpenUrl(urls[17]))
        && (urls.size() < 19 || isValidOpenUrl(urls[18]))
        && (urls.size() < 20 || isValidOpenUrl(urls[19]))
        && (urls.size() < 21 || isValidOpenUrl(urls[20]))
        && (urls.size() < 22 || isValidOpenUrl(urls[21]))
        && (urls.size() < 23 || isValidOpenUrl(urls[22]))
        && (urls.size() < 24 || isValidOpenUrl(urls[23]))
        && (urls.size() < 25 || isValidOpenUrl(urls[24]))
        && (urls.size() < 26 || isValidOpenUrl(urls[25]))
        && (urls.size() < 27 || isValidOpenUrl(urls[26]))
        && (urls.size() < 28 || isValidOpenUrl(urls[27]))
        && (urls.size() < 29 || isValidOpenUrl(urls[28]))
        && (urls.size() < 30 || isValidOpenUrl(urls[29]))
        && (urls.size() < 31 || isValidOpenUrl(urls[30]))
        && (urls.size() < 32 || isValidOpenUrl(urls[31]))
        && (urls.size() < 33 || isValidOpenUrl(urls[32]))
        && (urls.size() < 34 || isValidOpenUrl(urls[33]))
        && (urls.size() < 35 || isValidOpenUrl(urls[34]))
        && (urls.size() < 36 || isValidOpenUrl(urls[35]))
        && (urls.size() < 37 || isValidOpenUrl(urls[36]))
        && (urls.size() < 38 || isValidOpenUrl(urls[37]))
        && (urls.size() < 39 || isValidOpenUrl(urls[38]))
        && (urls.size() < 40 || isValidOpenUrl(urls[39]))
        && (urls.size() < 41 || isValidOpenUrl(urls[40]))
        && (urls.size() < 42 || isValidOpenUrl(urls[41]))
        && (urls.size() < 43 || isValidOpenUrl(urls[42]))
        && (urls.size() < 44 || isValidOpenUrl(urls[43]))
        && (urls.size() < 45 || isValidOpenUrl(urls[44]))
        && (urls.size() < 46 || isValidOpenUrl(urls[45]))
        && (urls.size() < 47 || isValidOpenUrl(urls[46]))
        && (urls.size() < 48 || isValidOpenUrl(urls[47]))
        && (urls.size() < 49 || isValidOpenUrl(urls[48]))
        && (urls.size() < 50 || isValidOpenUrl(urls[49]));
    }

    // Shared schema validator for profile_cookies collection
    function isValidProfileCookies(profileId) {
      let data = request.resource.data;
      return hasOnlyAllowedProfileCookiesFields(data)
        && hasRequiredProfileCookiesFields(data)
        && data.profileId is string
        && data.profileId == profileId
        && profileId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && data.updatedAt is int
        && data.updatedAt >= 0
        && data.updatedAt <= 4102444800000
        && data.count is int
        && data.count >= 0
        && data.cookiesJson is string
        && data.cookiesJson.size() <= 1048576
        && isValidOpenUrls(data.openUrls);
    }

    match /users/{userId}/profiles/{profileId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(profileId);
      allow update: if isOwner(userId)
        && isValidProfile(profileId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isTemporary == resource.data.isTemporary
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/profile_cookies/{profileId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfileCookies(profileId);
      allow update: if isOwner(userId)
        && isValidProfileCookies(profileId)
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isOwner(userId);
    }

    // Default deny for all other paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
